<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="com.warden.controlledsandbox.fixture32" />
        <provider android:authorities="com.warden.controlledsandbox.fixture32.provider" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <application
        android:name="com.warden.controlledsandbox.fixture.FixtureApplication"
        android:allowBackup="false"
        android:label="Controlled Sandbox Fixture"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">
        <activity android:name="com.warden.controlledsandbox.fixture.MainActivity" android:exported="true">
            <meta-data android:name="cas.fixture.activity_meta" android:value="activity-main" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.warden.controlledsandbox.fixture.NativeAdversarialProbeActivity"
            android:exported="true"
            android:noHistory="true" />
        <activity android:name="com.warden.controlledsandbox.fixture.NativeEnforcementSeccompActivity"
            android:exported="true"
            android:noHistory="true" />
        <service android:name="com.warden.controlledsandbox.fixture.NativeAdversarialProbeService"
            android:exported="true" />
        <activity android:name="com.warden.controlledsandbox.fixture.SystemHolderPendingIntentActivity"
            android:exported="true" />
        <service android:name="com.warden.controlledsandbox.fixture.SystemHolderKeepAliveService"
            android:exported="false" />
        <receiver android:name="com.warden.controlledsandbox.fixture.SystemHolderPendingIntentReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.warden.controlledsandbox.fixture.SYSTEM_HOLDER_ALARM" />
                <action android:name="com.warden.controlledsandbox.fixture.SYSTEM_HOLDER_NOTIFICATION" />
            </intent-filter>
        </receiver>
        <service android:name="com.warden.controlledsandbox.fixture.NativeEnforcementSeccompService"
            android:exported="true"
            android:isolatedProcess="true"
            android:process=":native_enf_iso" />
        <activity android:name="com.warden.controlledsandbox.fixture.CapabilityProbeActivity" android:exported="true" />
        <activity android:name="com.warden.controlledsandbox.fixture.LegacyCameraProbeActivity" android:exported="true" />
        <activity android:name="com.warden.controlledsandbox.fixture.FrameworkProbeActivity" android:exported="false" />
        <activity android:name="com.warden.controlledsandbox.fixture.PmsPermissionAttributionProbeActivity"
            android:exported="false" />
        <activity android:name="com.warden.controlledsandbox.fixture.PersistableProbeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:documentLaunchMode="always"
            android:persistableMode="persistAcrossReboots"
            android:taskAffinity="${applicationId}.persistable"
            android:resizeableActivity="true" />
        <activity android:name="com.warden.controlledsandbox.fixture.TaskSemanticsProbeActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:documentLaunchMode="none"
            android:taskAffinity="${applicationId}.task" />
        <activity android:name="com.warden.controlledsandbox.fixture.StandardTaskProbeActivity"
            android:exported="false"
            android:launchMode="standard" />
        <activity android:name="com.warden.controlledsandbox.fixture.SingleTopProbeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.singletop" />
        <activity android:name="com.warden.controlledsandbox.fixture.SingleTopNonTopProbeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.singletopnontop" />
        <activity android:name="com.warden.controlledsandbox.fixture.ClearTopProbeActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.cleartop" />
        <activity android:name="com.warden.controlledsandbox.fixture.ClearTopStandardProbeActivity"
            android:exported="false"
            android:launchMode="standard"
            android:taskAffinity="${applicationId}.cleartopstandard" />
        <activity android:name="com.warden.controlledsandbox.fixture.ReorderToFrontProbeActivity"
            android:exported="false"
            android:launchMode="standard"
            android:taskAffinity="${applicationId}.reorder" />
        <activity android:name="com.warden.controlledsandbox.fixture.FrameworkActivityResultParentActivity"
            android:exported="false" />
        <activity android:name="com.warden.controlledsandbox.fixture.FrameworkActivityResultChildActivity"
            android:exported="false" />
        <activity android:name="com.warden.controlledsandbox.fixture.FaultJavaCrashActivity"
            android:exported="true" android:process=":fault_java" />
        <activity android:name="com.warden.controlledsandbox.fixture.FaultMainThreadCrashActivity"
            android:exported="true" android:process=":fault_main" />
        <activity android:name="com.warden.controlledsandbox.fixture.FaultAnrActivity"
            android:exported="true" android:process=":fault_anr" />
        <activity android:name="com.warden.controlledsandbox.fixture.FaultNativeCrashActivity"
            android:exported="true" android:process=":fault_native" />
        <activity android:name="com.warden.controlledsandbox.fixture.FaultNativeAbortActivity"
            android:exported="true" android:process=":fault_abort" />
        <service android:name="com.warden.controlledsandbox.fixture.FaultCrashService"
            android:exported="true" android:process=":fault_svc" />
        <service android:name="com.warden.controlledsandbox.fixture.FaultAnrService"
            android:exported="true" android:process=":fault_anr_svc" />
        <provider
            android:name="com.warden.controlledsandbox.fixture.FaultAnrProvider"
            android:authorities="${applicationId}.fault.anr"
            android:exported="false"
            android:process=":fault_anr_provider" />
        <activity android:name="com.warden.controlledsandbox.fixture.RecoveryServiceKickoffActivity"
            android:exported="false" android:noHistory="true" />
        <activity android:name="com.warden.controlledsandbox.fixture.ForegroundServiceKickoffActivity"
            android:exported="false" android:noHistory="true" />
        <activity android:name="com.warden.controlledsandbox.fixture.FixtureJobScheduleActivity" android:exported="true" />
        <activity android:name="com.warden.controlledsandbox.fixture.FixtureJobWorkItemScheduleActivity" android:exported="true" />
        <activity android:name="com.warden.controlledsandbox.fixture.FixtureJobCancelActivity" android:exported="true" />
        <activity android:name="com.warden.controlledsandbox.fixture.FixtureJobDelayedActivity" android:exported="true" />
        <activity android:name="com.warden.controlledsandbox.fixture.DetailActivity" android:exported="false" />
        <activity android:name="com.warden.controlledsandbox.fixture.RemoteActivity" android:exported="false" android:process=":remote" />
        <service android:name="com.warden.controlledsandbox.fixture.FixtureService" android:exported="false">
            <meta-data android:name="cas.fixture.service_meta" android:value="service-main" />
        </service>
        <service android:name="com.warden.controlledsandbox.fixture.RemoteFixtureService" android:exported="false" android:process=":remote" />
        <service android:name="com.warden.controlledsandbox.fixture.IsolatedFixtureService" android:exported="false" android:isolatedProcess="true" />
        <service android:name="com.warden.controlledsandbox.fixture.IsolatedFaultNativeService"
            android:exported="true"
            android:isolatedProcess="true"
            android:process=":fault_iso_native" />
        <service android:name="com.warden.controlledsandbox.fixture.FixtureJobService"
            android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name="com.warden.controlledsandbox.fixture.FixtureReceiver" android:exported="true">
            <meta-data android:name="cas.fixture.receiver_meta" android:value="receiver-main" />
            <intent-filter>
                <action android:name="com.warden.controlledsandbox.fixture.PING" />
                <action android:name="com.warden.controlledsandbox.fixture.FRAMEWORK_RECEIVER_PROBE" />
                <action android:name="com.warden.controlledsandbox.fixture.FRAMEWORK_ORDERED_RECEIVER_PROBE" />
                <action android:name="com.warden.controlledsandbox.fixture.FRAMEWORK_ORDERED_RECEIVER_ASYNC_PROBE" />
            </intent-filter>
        </receiver>
        <receiver android:name="com.warden.controlledsandbox.fixture.BroadcastCampaignHighReceiver"
            android:exported="true">
            <intent-filter android:priority="200">
                <action android:name="com.warden.controlledsandbox.fixture.C1_T03_EXPLICIT" />
                <action android:name="com.warden.controlledsandbox.fixture.C1_T03_IMPLICIT" />
                <action android:name="com.warden.controlledsandbox.fixture.C1_T03_ORDERED" />
                <action android:name="com.warden.controlledsandbox.fixture.C1_T03_ABORT" />
                <action android:name="com.warden.controlledsandbox.fixture.C1_T03_PERMISSION" />
            </intent-filter>
        </receiver>
        <receiver android:name="com.warden.controlledsandbox.fixture.BroadcastCampaignLowReceiver"
            android:exported="true">
            <intent-filter android:priority="100">
                <action android:name="com.warden.controlledsandbox.fixture.C1_T03_IMPLICIT" />
                <action android:name="com.warden.controlledsandbox.fixture.C1_T03_ORDERED" />
                <action android:name="com.warden.controlledsandbox.fixture.C1_T03_ABORT" />
                <action android:name="com.warden.controlledsandbox.fixture.C1_T03_PERMISSION" />
            </intent-filter>
        </receiver>
        <receiver android:name="com.warden.controlledsandbox.fixture.BroadcastCampaignAsyncReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.warden.controlledsandbox.fixture.C1_T03_ASYNC" />
            </intent-filter>
        </receiver>
        <activity android:name="com.warden.controlledsandbox.fixture.BroadcastCampaignActivity"
            android:exported="false" />
        <activity android:name="com.warden.controlledsandbox.fixture.ProviderCampaignActivity"
            android:exported="false" />
        <provider
            android:name="com.warden.controlledsandbox.fixture.FixtureProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true"
            android:process=":provider">
            <meta-data android:name="cas.fixture.provider_meta" android:value="provider-main" />
        </provider>
    </application>
</manifest>
