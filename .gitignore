.gradle/
.gradle-*/
.idea/
**/build/
local.properties
*.iml
captures/
.externalNativeBuild/
.cxx/
__pycache__/
*.py[cod]

# Local packaging and capability-run output.
_delivery/
artifacts/
verification/catch-up/

# Transient verification/device output.
verification/*-working.txt
**/logcat/
**/*logcat*.txt
**/screenshots/
**/*screenshot*.png
**/device-dumps/
**/rerun/
**/retry/
**/repro/
**/continuation/
