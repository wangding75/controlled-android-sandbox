.gradle/
.idea/
**/build/
local.properties
*.iml
captures/
.externalNativeBuild/
.cxx/
.gradle-reproducible/
.gradle-user/
.gradle-user-home/
$d/
caches/
/android/
/daemon/
/native/
/notifications/
