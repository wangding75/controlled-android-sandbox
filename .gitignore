**/*.lastgood
**/*.registry

# Bundles are ignored only inside generated evidence/package directories.
artifacts/**/*.bundle
verification/catch-up/**/*.bundle
_delivery/**/*.bundle

# javac emits transient @arg files in the repository root for long source lists.
javac.*.args
