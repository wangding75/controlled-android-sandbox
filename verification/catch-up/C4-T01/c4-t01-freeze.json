  "engine_methods": [
    {"id": "initialize", "disposition": "REPLACE", "cas_target": "SandboxSdk.status / Host Application"},
    {"id": "onAttachBaseContext", "disposition": "DELETE", "cas_target": "none — no BlackBox ClassLoader hook"},
    {"id": "onAppCreate", "disposition": "REPLACE", "cas_target": "RuntimeBroker prepare"},
    {"id": "isReady", "disposition": "REPLACE", "cas_target": "SandboxSdk.status"},
    {"id": "installFromHost", "disposition": "REPLACE", "cas_target": "SandboxSdk.importPackage / importInstalledApplication"},
    {"id": "installFromApk", "disposition": "REPLACE", "cas_target": "SandboxSdk.importPackage"},
    {"id": "uninstall", "disposition": "REPLACE", "cas_target": "SandboxSdk.deleteInstance"},
    {"id": "clearData", "disposition": "REPLACE", "cas_target": "SandboxSdk.clearData"},
    {"id": "listInstalled", "disposition": "REPLACE", "cas_target": "SandboxSdk.catalog"},
    {"id": "get", "disposition": "REPLACE", "cas_target": "SandboxCatalog / SandboxInstance"},
    {"id": "isInstalled", "disposition": "REPLACE", "cas_target": "SandboxSdk.catalog"},
    {"id": "launch", "disposition": "REPLACE", "cas_target": "SandboxSdk.launch"},
    {"id": "kill", "disposition": "REPLACE", "cas_target": "SandboxSdk.stop"},
    {"id": "killAll", "disposition": "REPLACE", "cas_target": "per-instance SandboxSdk.stop"},
    {"id": "clone", "disposition": "REPLACE", "cas_target": "SandboxSdk.cloneInstance"},
    {"id": "createShortcut", "disposition": "REPLACE", "cas_target": "SandboxSdk.launch + public instanceId"},
    {"id": "setDisplayName", "disposition": "REPLACE", "cas_target": "SandboxPackage.label"}
  ],
  "startup_entries": [
    {"id": "SxApp.attachBaseContext", "disposition": "REPLACE", "cas_target": "Host Application without SandboxProvider/BlackBox"},
    {"id": "SandboxProvider.init", "disposition": "DELETE", "cas_target": "none — C4-T02 adapter is the engine"},
    {"id": "BlackBoxSandboxEngine", "disposition": "DELETE", "cas_target": "none"},
    {"id": "FakeSandboxEngine", "disposition": "DELETE", "cas_target": "SDK self-test / fixture"},
    {"id": "BuildConfig.SANDBOX_ENGINE", "disposition": "DELETE", "cas_target": "CAS is the only engine"}
  ],
  "ui_entries": [
    {"id": "SplashActivity", "disposition": "REPLACE", "cas_target": "CAS Host splash / MainActivity"},
    {"id": "MainActivity", "disposition": "GENERIC_ALREADY", "cas_target": "app MainActivity"},
    {"id": "HomeFragment", "disposition": "GENERIC_ALREADY", "cas_target": "home tab"},
    {"id": "AppListActivity/AppListFragment", "disposition": "GENERIC_ALREADY", "cas_target": "apps tab + catalog"},
    {"id": "AppPickerActivity", "disposition": "GENERIC_ALREADY", "cas_target": "installed / document picker"},
    {"id": "AppDetailActivity", "disposition": "GENERIC_ALREADY", "cas_target": "InstanceSettingsActivity"},
    {"id": "LocationSettingsActivity", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T03 location profile UI"},
    {"id": "LocationPickerActivity", "disposition": "DROP_NON_BUSINESS", "cas_target": "NOT_IMPLEMENTED map picker"},
    {"id": "DeviceSettingsActivity", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T06 device profile UI"},
    {"id": "NetworkSettingsActivity", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T06 network profile UI"},
    {"id": "VirtualCameraActivity", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T04 camera profile UI"},
    {"id": "ShortcutLaunchActivity", "disposition": "REPLACE", "cas_target": "SandboxSdk.launch"},
    {"id": "MockLocationService", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T03 Guest location"},
    {"id": "SpoofProbeActivity", "disposition": "REPLACE", "cas_target": "DeveloperDiagnosticsActivity"},
    {"id": "LicenseActivity", "disposition": "DROP_NON_BUSINESS", "cas_target": "none"},
    {"id": "PrivacyPolicyActivity", "disposition": "DROP_NON_BUSINESS", "cas_target": "product legal, not sandbox"},
    {"id": "MeFragment", "disposition": "GENERIC_ALREADY", "cas_target": "Me tab"}
  ],
  "f1_f5_hooks": [
    {"id": "F1-CameraHook", "domain": "camera", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T04 Camera1/Camera2"},
    {"id": "F2-LocationHook", "domain": "location", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T03 Location"},
    {"id": "F3-DeviceHook", "domain": "device", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T06 identity/telephony"},
    {"id": "F3-CellHook", "domain": "cell", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T06 telephony"},
    {"id": "F4-NetworkHook", "domain": "network", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T06 connectivity/wifi"},
    {"id": "F5-BluetoothHook", "domain": "bluetooth", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T06 bluetooth"},
    {"id": "SpoofRuntime", "domain": "hook-install", "disposition": "DELETE", "cas_target": "none"},
    {"id": "DingTalkHook", "domain": "dingtalk", "disposition": "REPLACE", "cas_target": "C4-T05 CompatibilityPatchRegistry default-off"}
  ],
  "data_stores": [
    {"id": "sx_config SharedPreferences", "keys": ["location", "device", "network", "camera", "bluetooth", "sandbox_apps", "license", "time_guard", "global"], "disposition": "REIMPLEMENT_DATA", "cas_target": "instance-scoped virtual profiles", "owner_task": "C4-T03"},
    {"id": "ConfigProvider", "disposition": "REIMPLEMENT_DATA", "cas_target": "CAS Provider + instance profile; no same-UID BlackBox sharing", "owner_task": "C4-T03"},
    {"id": "ProfileRepository", "disposition": "REIMPLEMENT_DATA", "cas_target": "CAS profile stores; delete BlackBoxCore reflection", "owner_task": "C4-T03"},
    {"id": "ConfigBroadcast", "disposition": "REIMPLEMENT_DATA", "cas_target": "CAS profile observers", "owner_task": "C4-T03"},
    {"id": "sx_app_labels", "disposition": "REPLACE", "cas_target": "SandboxPackage.label"},
    {"id": "camera media bytes via ConfigProvider", "disposition": "REIMPLEMENT_DATA", "cas_target": "C2-T04 source media in instance scope", "owner_task": "C4-T03"},
    {"id": "sx_license / DeviceFingerprint / TimeGuard", "disposition": "DROP_NON_BUSINESS", "cas_target": "none"}
  ],
  "dynamic_loads": [
    {"class": "top.niunaijun.blackbox.BlackBoxCore", "where": "ProfileRepository, ConfigBroadcast", "disposition": "DELETE"},
    {"class": "com.sx.app.BuildConfig", "where": "LicenseManager", "disposition": "DROP_NON_BUSINESS"},
    {"class": "android.hardware.camera2.ImageReader", "where": "CameraHook", "disposition": "GENERIC_ALREADY", "cas_target": "C2-T04 Camera2"},
    {"asset": "assets/xposed_init", "where": "SX app", "disposition": "DELETE"},
    {"library": "libpine.so / libblackbox.so", "where": "Bcore/Pine", "disposition": "DELETE"}
  ],
  "unknown_or_missing": [
    {"id": "com.sx.app.xposed.SxModule", "note": "xposed_init points at a class absent from current non-build sources", "disposition": "DELETE"},
    {"id": "LocationPicker map SDK", "note": "UI inventory already NOT_IMPLEMENTED", "disposition": "DROP_NON_BUSINESS"}
  ],
  "blockers": [
    {"id": "C4-T02", "disposition": "REPLACE", "cas_target": "SandboxSdk adapter", "summary": "SandboxProvider still selects BlackBoxSandboxEngine in live SX; CAS adapter is not yet the SX production engine"},
    {"id": "C4-T03", "disposition": "REIMPLEMENT_DATA", "cas_target": "instance-scoped profiles", "summary": "sx_config / ConfigProvider still assume shared UID with BlackBox guests"},
    {"id": "C4-T04", "disposition": "DELETE", "cas_target": "none", "summary": "engine-bb and Bcore/Pine remain on the SX Gradle graph"}
  ]
}
