    {"id": ":app", "disposition": "REPLACE", "cas_target": "app UI + SxSandboxAdapter", "owner_task": "C4-T02"},
    {"id": ":sandbox-api", "disposition": "REPLACE", "cas_target": "sandbox-sdk SandboxSdk", "owner_task": "C4-T02"},
    {"id": ":engine-bb", "disposition": "DELETE", "cas_target": "none", "owner_task": "C4-T04"},
    {"id": ":Bcore", "disposition": "DELETE", "cas_target": "none", "owner_task": "C4-T04"},
    {"id": ":Bcore:black-fake", "disposition": "DELETE", "cas_target": "none", "owner_task": "C4-T04"},
    {"id": ":Bcore:black-hook", "disposition": "DELETE", "cas_target": "none", "owner_task": "C4-T04"},
    {"id": ":Bcore:pine-core", "disposition": "DELETE", "cas_target": "none", "owner_task": "C4-T04"},
    {"id": ":Bcore:pine-xposed", "disposition": "DELETE", "cas_target": "none", "owner_task": "C4-T04"},
    {"id": ":Bcore:pine-xposed-res", "disposition": "DELETE", "cas_target": "none", "owner_task": "C4-T04"},
    {"id": ":android-mirror", "disposition": "DELETE", "cas_target": "none", "owner_task": "C4-T04"},
    {"id": "de.robv.android.xposed:api", "disposition": "DELETE", "cas_target": "none", "owner_task": "C4-T04"}
