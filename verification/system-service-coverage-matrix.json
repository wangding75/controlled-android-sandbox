    },
    {
      "id": "location",
      "hook": "bounded-method-proxy",
      "isolation": "generation-capability",
      "production": "wired",
      "hostFallback": "fail-closed-without-proxy",
      "device": "not-tested"
    },
    {
      "id": "audio",
      "hook": "bounded-audiomanager-capture-proxy",
      "isolation": "generation-capability",
      "production": "partial",
      "hostFallback": "native-paths-not-covered",
      "device": "not-tested"
    },
    {
      "id": "alarm",
      "hook": "binder-owned-persistent-callback-scheduler",
      "isolation": "package-user-process-generation",
      "production": "wired",
      "hostFallback": "denied",
      "device": "not-tested"
    },
    {
      "id": "clipboard",
      "hook": "binder-owned-cross-process-store",
      "isolation": "package-user",
      "production": "wired",
      "hostFallback": "denied",
      "device": "not-tested"
    },
    {
      "id": "account",
      "hook": "binder-owned-cross-process-basic-store",
