      "device": "not-tested"
    },
    {
      "id": "appops",
      "hook": "virtual-policy-and-attribution",
      "isolation": "package-user-policy",
      "production": "wired",
      "hostFallback": "fail-closed-for-guest",
      "device": "not-tested"
    },
    {
      "id": "permission",
      "hook": "virtual-policy-and-runtime-workflow",
      "isolation": "package-user-policy",
      "production": "wired",
      "hostFallback": "fail-closed-for-guest",
      "device": "not-tested"
    },
    {
      "id": "camera",
