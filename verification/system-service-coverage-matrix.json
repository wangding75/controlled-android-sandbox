      "isolation": "package-user",
      "production": "partial",
      "hostFallback": "delegated-after-rewrite",
      "device": "not-tested"
    },
    {
      "id": "job-scheduler",
      "hook": "persistent-id-query-namespace",
      "isolation": "package-user",
      "production": "partial",
      "hostFallback": "delegated-after-rewrite",
      "device": "not-tested"
    },
    {
      "id": "pending-intent",
      "hook": "virtual-sender-registry-and-broker-route",
      "isolation": "package-user-generation",
      "production": "wired",
      "hostFallback": "known-virtual-senders-denied",
      "device": "not-tested"
    },
    {
      "id": "storage",
      "hook": "path-and-manager-rewrite",
      "isolation": "instance-path",
      "production": "partial",
      "hostFallback": "bounded",
      "device": "not-tested"
    }
  ],
  "limitations": [
    "All rows remain source/host evidence only; no Android device evidence exists.",
    "Alarm persistence stores marshalled Parcelable delivery tokens and retries without a matching process owner, but does not reproduce Android AlarmManager wakeup, Doze, exact-alarm permission or reboot semantics.",
    "Clipboard and Account are Binder-owned by package/user; real OEM ClipData listeners and full Authenticator/OAuth flows are not verified.",
    "Notification and Job namespaces persist, while cancelAll, complete channel/job lifecycle and callback recovery remain partial.",
    "Native AudioRecord/MediaRecorder and OEM Binder variants remain outside the current bounded proxy coverage."
  ]
}
