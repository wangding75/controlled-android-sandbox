{
  "schemaVersion": 1,
  "scope": "source-production-device-system-service-evidence",
  "services": [
    {
      "id": "package-manager",
      "hook": "virtual-query-and-resolve",
      "isolation": "package-user-policy",
      "production": "wired",
      "hostFallback": "bounded-system-only",
      "device": "not-tested"
    },
    {
      "id": "activity-manager",
      "hook": "identity-proxy-and-runtime-router",
      "isolation": "session-generation",
      "production": "wired",
